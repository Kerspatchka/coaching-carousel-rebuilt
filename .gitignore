# Curated UI assets are committed as one archive, then expanded locally for Vite.
/assets/ui_pack/*
!/assets/ui_pack/README.md
!/assets/ui_pack/ccr-ui-assets.zip
!/assets/ui_pack/SHA256SUMS.txt
